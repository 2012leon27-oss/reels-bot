# Telegram Business neuroagent — переменные окружения
# Скопируйте в .env и заполните. Не коммитьте .env.

# Токен бота от @BotFather (поддерживаются оба имени)
TELEGRAM_BOT_TOKEN=
# BOT_TOKEN=   # alias для TELEGRAM_BOT_TOKEN

# Числовой Telegram user ID владельца (поддерживаются оба имени)
OWNER_TELEGRAM_ID=
# OWNER_ID=   # alias для OWNER_TELEGRAM_ID

# Локальный HTTP-мост к SyntX (Playwright)
SYNTX_BRIDGE_URL=http://127.0.0.1:8000/syntx_chat

# sqlite:///data/bot.db  или  postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///data/bot.db

# Память и сессии
MEMORY_RETENTION_DAYS=15
RECENT_MESSAGE_LIMIT=30
SESSION_INACTIVITY_MINUTES=30

# Ротация чата SyntX (изоляция контекста между диалогами)
SYNTX_CHAT_ROTATION_HOURS=24
SYNTX_CHAT_MAX_MESSAGES=40

# Каналы алертов: telegram (по умолчанию), sms, push — через запятую
ALERT_CHANNELS=telegram

# SMS (опционально; без ключей SMS не отправляется)
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
OWNER_PHONE=

# Push webhook (опционально)
PUSH_WEBHOOK_URL=

# Поведение ассистента
CONFIDENCE_THRESHOLD=0.75
AUTO_REPLY_ENABLED=false

# Порт health-сервера бота (Render/hosting)
PORT=10000

# --- SyntX bridge (опционально, значения по умолчанию в integrations/syntx/config.py) ---
# SYNTX_BRIDGE_PORT=8000
# SYNTX_BROWSER_PROFILE_DIR=./syntx_browser_profile
# SYNTX_HEADLESS=false
# SYNTX_MODEL_NAME=Claude 4.8 Opus

# --- Legacy LLM (старый путь через OpenAI-совместимый API; neuroagent использует SyntX) ---
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=3
# ESCALATE_UNKNOWN_CONTACTS=true
# HISTORY_LIMIT=30
