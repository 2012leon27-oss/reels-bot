BOT_TOKEN=replace_with_new_botfather_token
OWNER_ID=replace_with_your_numeric_telegram_id
DATABASE_URL=postgresql://user:password@host:5432/database

# Любой OpenAI-совместимый API. Значения ниже подходят для Groq.
LLM_API_KEY=replace_with_new_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Защитный выключатель. Оставьте false, пока контекст и тестовый чат не готовы.
AUTO_REPLY_ENABLED=false
ESCALATE_UNKNOWN_CONTACTS=true
CONFIDENCE_THRESHOLD=0.82
HISTORY_LIMIT=30

PORT=10000
