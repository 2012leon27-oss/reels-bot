APP_ENV=production
APP_BASE_URL=https://your-service.onrender.com
APP_ACCESS_KEY=replace-with-a-long-random-secret

# Groq API (text structuring + Whisper transcription)
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional Telegram Mini App and bot
BOT_TOKEN=replace-with-your-telegram-bot-token
ADMIN_ID=123456789
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Render can inject this from a managed PostgreSQL database.
DATABASE_URL=postgresql://user:password@host/database

# Local SQLite is used automatically when DATABASE_URL is absent.
SQLITE_PATH=data/thoughts.db
NOTES_OUTPUT_DIR=notes
PORT=10000
